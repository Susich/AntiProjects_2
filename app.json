{
  "expo": {
    "name": "PartySplit",
    "slug": "partysplit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F17",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.partysplit.app"
    },
    "android": {
      "package": "com.partysplit.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F17"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e1b710f5-32ec-4996-a513-f661e996d103"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F17",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
