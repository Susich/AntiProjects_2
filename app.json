{
  "expo": {
    "name": "PartySplit",
    "slug": "partysplit",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F17",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.partysplit.app"
    },
    "android": {
      "package": "com.partysplit.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B0F17"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "REQUEST_INSTALL_PACKAGES",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "meta": {
        "viewport": "width=device-width, initial-scale=1, minimum-scale=1, viewport-fit=cover"
      }
    },
    "extra": {
      "eas": {
        "projectId": "e1b710f5-32ec-4996-a513-f661e996d103"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F17",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00F5A0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к галерее, чтобы установить фото профиля",
          "cameraPermission": "Разрешите доступ к камере, чтобы сделать фото профиля"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера используется для сканирования QR-кода комнаты."
        }
      ],
      "expo-status-bar",
      "expo-sharing"
    ]
  }
}
